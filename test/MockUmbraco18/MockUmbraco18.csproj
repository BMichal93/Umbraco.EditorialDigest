<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UmbracoVersion>18.1.0</UmbracoVersion>
    <CompressionEnabled>false</CompressionEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Umbraco.Cms" Version="$(UmbracoVersion)" />
    <PackageReference Include="Umbraco.Cms.DevelopmentMode.Backoffice" Version="$(UmbracoVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Umbraco.EditorialDigest\Umbraco.EditorialDigest.csproj" AdditionalProperties="UmbracoVersion=$(UmbracoVersion)" />
    <Compile Include="..\Shared.MockUmbraco\**\*.cs" LinkBase="Shared.MockUmbraco" />
  </ItemGroup>
</Project>
