{
  "$schema": "../../umbraco-package-schema.json",
  "id": "Umbraco.EditorialDigest",
  "name": "Umbraco Editorial Digest",
  "version": "0.1.2",
  "extensions": [
    {
      "type": "dashboard",
      "alias": "Umbraco.EditorialDigest.Dashboard.Overview",
      "name": "Editorial Overview Dashboard",
      "element": "/App_Plugins/EditorialDigest/editorial-overview-dashboard.js",
      "elementName": "editorial-overview-dashboard",
      "weight": -10,
      "meta": {
        "label": "Editorial Overview",
        "pathname": "editorial-overview"
      },
      "conditions": [
        {
          "alias": "Umb.Condition.SectionAlias",
          "match": "Umb.Section.Content"
        }
      ]
    },
    {
      "type": "dashboard",
      "alias": "Umbraco.EditorialDigest.Dashboard.Settings",
      "name": "Editorial Digest Settings Dashboard",
      "element": "/App_Plugins/EditorialDigest/editorial-digest-settings.js",
      "elementName": "editorial-digest-settings",
      "weight": -10,
      "meta": {
        "label": "Editorial Digest",
        "pathname": "editorial-digest"
      },
      "conditions": [
        {
          "alias": "Umb.Condition.SectionAlias",
          "match": "Umb.Section.Settings"
        }
      ]
    }
  ]
}
