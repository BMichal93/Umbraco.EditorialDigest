<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <UmbracoVersion Condition="'$(UmbracoVersion)' == ''">18.1.0</UmbracoVersion>
    <AssemblyName>Umbraco.EditorialDigest</AssemblyName>
    <RootNamespace>Umbraco.EditorialDigest</RootNamespace>
    <PackageId>Umbraco.EditorialDigest</PackageId>
    <Version>0.1.1</Version>
    <Authors>BMichal93;OpenAI Codex</Authors>
    <Description>Scheduled editorial intelligence digests for Umbraco.</Description>
    <PackageTags>umbraco;editorial;digest</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/BMichal93/Umbraco.EditorialDigest</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <NuspecFile>Umbraco.EditorialDigest.nuspec</NuspecFile>
    <NuspecProperties>PackageId=$(PackageId);Version=$(Version);Authors=BMichal93,OpenAI Codex;Description=Scheduled editorial intelligence digests for Umbraco.;PackageTags=umbraco editorial digest;Configuration=$(Configuration)</NuspecProperties>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeBuildOutput>true</IncludeBuildOutput>
    <IsPackable>true</IsPackable>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <IncludeRazorContentInPack>true</IncludeRazorContentInPack>
    <StaticWebAssetBasePath>/</StaticWebAssetBasePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Umbraco.Cms.Api.Management" Version="$(UmbracoVersion)" />
    <PackageReference Include="Umbraco.Cms.Core" Version="$(UmbracoVersion)" />
    <PackageReference Include="Umbraco.Cms.Web.Common" Version="$(UmbracoVersion)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\..\CONTRIBUTORS.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
