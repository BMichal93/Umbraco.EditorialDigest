@model Umbraco.EditorialDigest.Services.EditorialDigestEmailModel
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@Model.Configuration.Name</title>
</head>
<body style="margin:0;background:#f5f5f5;color:#1f2933;font-family:Arial,sans-serif;line-height:1.5;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0">
        <tr><td align="center" style="padding:24px 12px;">
            <table role="presentation" width="600" cellspacing="0" cellpadding="0" style="max-width:600px;width:100%;background:#ffffff;">
                <tr><td style="padding:24px;border-bottom:1px solid #d9e2ec;">
                    @if (!string.IsNullOrWhiteSpace(Model.GlobalSettings.LogoUrl))
                    {
                        <img src="@Model.GlobalSettings.LogoUrl" alt="Site logo" style="max-height:48px;max-width:180px;" />
                    }
                    <h1 style="margin:16px 0 0;font-size:24px;">@Model.Configuration.Name</h1>
                    <p style="margin:4px 0 0;color:#52606d;">@Model.RangeStartUtc.ToString("yyyy-MM-dd HH:mm") – @Model.RangeEndUtc.ToString("yyyy-MM-dd HH:mm") UTC</p>
                </td></tr>
                @foreach (var section in Model.Data.Sections.Where(section => section.Items.Count > 0))
                {
                    <tr><td style="padding:24px 24px 0;"><h2 style="margin:0;font-size:18px;">@(section.Section)</h2></td></tr>
                    <tr><td style="padding:12px 24px;"><table role="presentation" width="100%" cellspacing="0" cellpadding="0">
                        @foreach (var item in section.Items)
                        {
                            <tr><td style="padding:12px 0;border-bottom:1px solid #d9e2ec;">
                                <strong>@item.Name</strong><br />
                                <span style="color:#52606d;">@item.ContentTypeAlias · @item.Context</span><br />
                                <span style="color:#52606d;">@item.Status</span>
                            </td></tr>
                        }
                    </table></td></tr>
                }
                <tr><td style="padding:24px;color:#52606d;font-size:13px;"><a href="@Model.DashboardUrl">View full dashboard in backoffice</a></td></tr>
            </table>
        </td></tr>
    </table>
</body>
</html>
